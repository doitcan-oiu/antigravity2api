# 控制台登录令牌（浏览器打开后台时使用）
ADMIN_TOKEN=admin-token

# 反代调用密钥（OpenAI / Claude / Gemini 客户端使用）
API_KEY=sk-antigravity

# 宿主机端口，容器内固定 8080
PORT=8080

LISTEN_ADDR=:8080
DATA_DIR=./data
BATCH_VALIDITY_DAYS=30
SKIP_EXPIRED_ACCOUNTS=true

# 单进程并发、重试和生命周期（单账号并发不能提升上游额度）
MAX_CONCURRENT_REQUESTS=128
MAX_CONCURRENT_PER_ACCOUNT=4
MAX_RETRY_ATTEMPTS=5
ADMISSION_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=600
SHUTDOWN_TIMEOUT_SECONDS=30
